<UserControl x:Class="PR8.Elements.Item"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PR8.Elements"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Border VerticalAlignment="Center" HorizontalAlignment="Center" Background="Gray" CornerRadius="20">
            <StackPanel>
                <Image Source="/Images/image1.png" Height="200" Margin="10"/>
                <Label Content="Наименование" Name="nameProduct" HorizontalAlignment="Center" Foreground="White"/>
                <Grid Height="100">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Name="leftStakPanel" Margin="10" >
                        <Label Content="Цена" Foreground="White"/>
                        <Label  Content="Характеристика" Foreground="White"/>
                    </StackPanel>
                    <StackPanel Name="rightStackPanel" Grid.Column="1" Margin="10">
                        <Label Name="lablePrice" Content="" Foreground="White"/>
                        <Label Name="lableCharac" Content="" Foreground="White" />
                    </StackPanel>
                </Grid>


            </StackPanel>
            <Border.Effect>
                <DropShadowEffect BlurRadius="11"/>
            </Border.Effect>
        </Border>
        
        
            
    </Grid>
</UserControl>
